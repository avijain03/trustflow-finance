# ============================================================
#  TrustFlow Finance v2.0 — .gitignore
#  Monorepo: /backend (Node/Express) + /frontend (React/Vite)
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment & Secrets ────────────────────────────────────
# NEVER commit secrets. Use .env.example as the template.
.env
.env.*
!.env.example
*.env

# ── Build Outputs ─────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
frontend/dist/
frontend/build/

# ── Test & Coverage ───────────────────────────────────────────
coverage/
.nyc_output/
junit.xml
test-results/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── MongoDB in-memory binary (downloaded at runtime) ─────────
# mongodb-memory-server caches the mongod binary — do NOT commit
.cache/
**/mongodb-memory-server/
**/MongoBinaries/

# ── Vite / ESBuild cache ──────────────────────────────────────
frontend/.vite/
**/.vite/
*.tsbuildinfo

# ── OS & System Files ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE — VS Code ─────────────────────────────────────────────
.vscode/
*.code-workspace
.history/

# ── IDE — JetBrains (WebStorm, IntelliJ, etc.) ───────────────
.idea/
*.iml
*.iws
*.ipr

# ── IDE — Vim / Emacs ─────────────────────────────────────────
*.swp
*.swo
*~
\#*\#
.#*

# ══════════════════════════════════════════════════════════════
#  AGENTIC AI IDE — Antigravity / Gemini / Cursor / Windsurf
#  These files are generated by AI coding assistants and
#  contain session data, skill definitions, agent traces,
#  conversation logs, and knowledge bases.
#  They MUST NEVER be committed to a repository.
# ══════════════════════════════════════════════════════════════

# ── Antigravity / Gemini AI Assistant workspace ───────────────
.gemini/
.antigravity/

# ── Cursor IDE AI workspace ───────────────────────────────────
.cursor/
.cursorignore
.cursorrules

# ── Windsurf IDE AI workspace ─────────────────────────────────
.windsurf/
.windsurfrules

# ── Cline / Continue AI assistant ────────────────────────────
.cline/
.continue/
.continuerules

# ── GitHub Copilot workspace ──────────────────────────────────
.copilot/
.github/copilot-instructions.md

# ── General AI assistant config ───────────────────────────────
.aider*
.aider/
aider.conf.yml

# ── Agent definition files (project-level) ───────────────────
AGENTS.md
agents.md
SKILLS.md
skills.md
*.skill.md
*.agent.md
.agent-context/
agent-logs/
.agents/

# ── AI session artifacts, brain dumps & conversations ────────
brain/
.brain/
*.session.json
*.conversation.json
knowledge/
.knowledge/
.memory/
memory/

# ── Skill runner temporary files ─────────────────────────────
skill-output/
.skill-cache/
*.skill-run.json
skills/

# ── AI-generated scratch & artifact files ────────────────────
scratch/
.scratch/
artifacts/
.artifacts/

# ── LLM context cache ─────────────────────────────────────────
.llm-cache/
llm-cache/
.context/

# ── Temporary & Scratch files ─────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig

# ── Docker ────────────────────────────────────────────────────
# Keep Dockerfile and docker-compose.yml — exclude runtime state
.docker/
docker-volumes/

# ── Package manager lock files ────────────────────────────────
# Keep package-lock.json (npm). Exclude alternatives.
yarn.lock
pnpm-lock.yaml

# ── Render / Vercel deployment cache ──────────────────────────
.vercel/
.render/

# ── Optional: uploaded document storage (local dev only) ──────
uploads/
backend/uploads/

# ── TypeScript (if migrated later) ────────────────────────────
*.js.map
*.d.ts.map
