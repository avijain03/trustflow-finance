# ─── TrustFlow Finance — Environment Variables ───────────────────────────────
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Get a free M0 cluster at https://cloud.mongodb.com
# Leave blank in dev — app auto-uses in-memory MongoDB
MONGODB_URI=your_mongodb_atlas_connection_string

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be at least 32 characters in production
JWT_SECRET=your_32_char_jwt_secret_here_change_me
JWT_EXPIRY=7d

# ─── Internal Agent Auth ──────────────────────────────────────────────────────
# Separate secret for MasterAgent → Worker short-lived tokens (60s expiry)
INTERNAL_JWT_SECRET=your_32_char_internal_secret_change_me
INTERNAL_JWT_EXPIRY=60

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Credit Bureau API (Mock) ─────────────────────────────────────────────────
CREDIT_BUREAU_API_URL=https://mock-credit-bureau.example.com/v1
CREDIT_BUREAU_API_KEY=your_credit_bureau_api_key

# ─── CRM API (Mock) ───────────────────────────────────────────────────────────
CRM_API_URL=https://mock-crm.example.com/v1
CRM_API_KEY=your_crm_api_key
